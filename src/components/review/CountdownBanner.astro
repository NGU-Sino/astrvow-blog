---
/**
 * 考研倒计时横幅组件
 * 2027考研初试预计日期：2026年12月19日
 */
const EXAM_DATE = new Date("2026-12-19T00:00:00+08:00");
const now = new Date();
const diffMs = EXAM_DATE.getTime() - now.getTime();
const diffDays = Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
---

<div class="card-base p-5 mb-6 bg-gradient-to-r from-(--primary)/10 to-(--primary)/5">
	<div class="flex items-center justify-between flex-wrap gap-3">
		<div class="flex items-center gap-3">
			<span class="text-3xl">⏰</span>
			<div>
				<div class="text-sm text-neutral-500 dark:text-neutral-400">距离 2027 考研初试</div>
				<div class="text-lg font-bold text-neutral-700 dark:text-neutral-200">2026年12月19日</div>
			</div>
		</div>
		<div class="text-center">
			<span class="text-4xl font-bold text-(--primary)">{diffDays}</span>
			<span class="text-lg text-neutral-600 dark:text-neutral-300 ml-1">天</span>
		</div>
	</div>
</div>
